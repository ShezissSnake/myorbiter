{
  "name": "orbiter",
  "version": "0.1.0",
  "description": "Local-first Warframe collection helper that reads TennoScope's data: sets to sell, mastery to-do, arcane ranking, duplicate mods, vaulted relics.",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "ORBITER_DEMO=1 vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js",
    "tauri": "tauri",
    "test": "tsx --test tests/*.test.ts",
    "dev-bundle": "cargo run --release -q --manifest-path crates/orbiter-data/Cargo.toml --bin orbiter-dump > public/dev-bundle.json"
  },
  "dependencies": {
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-opener": "^2.7.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
