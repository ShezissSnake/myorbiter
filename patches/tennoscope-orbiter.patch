+    const RELIC: &str = "12.0 Script [Info]: x /Lotus/Types/Game/Projections/T4VoidProjectionVorunaPrimeCBronze ok\n";
+    const OPEN: &str = "13.0 Script [Info]: VoidProjections: OpenVoidProjectionRewardScreenRMI\n";
