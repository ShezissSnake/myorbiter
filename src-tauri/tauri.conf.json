{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myorbiter",
  "version": "0.1.0",
  "identifier": "dev.myorbiter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyOrbiter",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#0a0b0d"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' img: http://img.localhost data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://www-static.warframe.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' img: http://img.localhost data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://www-static.warframe.com ws://localhost:1421",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4QzFCQzZCRTJENUNGQjkKUldTNXo5WGlhN3pCNlB4WEl4MUpJdTVBM1pNZkYyYTRhYXdPYXFBV0hzS25LWlJJMDIxSUF2RUwK",
      "endpoints": ["https://gitlab.com/api/v4/projects/sheziss-group%2Fmyorbiter/packages/generic/channel/stable/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Game",
    "publisher": "MyOrbiter",
    "shortDescription": "Warframe companion",
    "longDescription": "Reads what TennoScope stores about your Warframe account to show sets you can sell, what you have not mastered, arcane collections, duplicate mods and vaulted relics, and keeps your warframe.market listings priced.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [],
        "conflicts": ["orbiter"],
        "replaces": ["orbiter"],
        "desktopTemplate": "linux/desktop.hbs"
      },
      "rpm": {
        "release": "1",
        "depends": [],
        "obsoletes": ["orbiter"],
        "desktopTemplate": "linux/desktop.hbs"
      }
    },
    "license": "GPL-3.0-only",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE.md": "NOTICE.md",
      "../THIRD-PARTY-NOTICES/": "THIRD-PARTY-NOTICES/"
    }
  }
}
