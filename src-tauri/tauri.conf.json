{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "orbiter",
  "version": "0.1.0",
  "identifier": "dev.orbiter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "orbiter",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#0a0b0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Game",
    "shortDescription": "Warframe collection helper",
    "longDescription": "Reads what TennoScope stores about your Warframe account to show sets you can sell, what you have not mastered, arcane collections, duplicate mods and vaulted relics, and keeps your warframe.market listings priced.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      },
      "rpm": {
        "release": "1",
        "depends": []
      }
    },
    "license": "MIT"
  }
}
